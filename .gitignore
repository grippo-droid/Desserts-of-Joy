# ---------------------------------------------------------------------------
# Desserts of Joy — digital menu
#
# IMPORTANT: everything the deployed site needs is tracked ON PURPOSE:
#   index.html, styles.css, script.js
#   fonts/*.woff2          the subsetted font files — the site breaks without them
#   fonts/OFL-*.txt        SIL Open Font Licence texts — legally required to ship
#
# Do NOT add broad patterns such as *.txt, *.woff2, fonts/ or dist/ here.
# ---------------------------------------------------------------------------

# Python bytecode, from running fonts/build-fonts.py
__pycache__/
*.py[cod]

# OS junk
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*~
